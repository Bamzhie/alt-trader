[Unit]
Description=ALT RADAR unattended collector+resolver (read-only, no orders)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Edit both paths below to your checkout location and Python:
WorkingDirectory=/home/YOU/alt-radar
ExecStart=/usr/bin/python3 -m proto.service --collect-every 300 --resolve-every 3600
Restart=always
RestartSec=60

[Install]
WantedBy=default.target
